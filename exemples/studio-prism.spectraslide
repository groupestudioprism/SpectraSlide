"id":"e079","t":"shape","k":"ellipse","x":232,"y":470,"w":116,"h":116,"fill":"#FFFFFF","r":16,"an":{"k":"pop"}},{"id":"e080","t":"img","x":248,"y":493,"w":84,"h":69,"src":"m:architrafic_emblem","fit":"contain","an":{"k":"pop"}},{"id":"e081","t":"text","x":222,"y":598,"w":136,"h":30,"html":"ArchiTrafic","st":{"f":"b","fs":15,"fc":"#FFFFFF","ha":"c","va":"t","lh":1.35,"b":1},"an":{"k":"fade"}},{"id":"e082","t":"shape","k":"ellipse","x":382,"y":470,"w":116,"h":116,"fill":"#FFFFFF","r":16,"an":{"k":"pop"}}],"notes":"Place à la gamme Archi. Nous commençons par les logiciels phares : ArchiVision et ArchiTrafic.","tr":"zoom","nodeco":true},{"id":"s06","v":"content","lay":"free","els":[{"id":"e085","t":"shape","k":"round","x":70,"y":70,"w":340,"h":128,"fill":"#FFFFFF","r":14,"an":{"k":"fade"}},{"id":"e086","t":"img","x":90,"y":90,"w":300,"h":88,"src":"m:archivision","fit":"contain","an":{"k":"fade"}},{"id":"e087","t":"shape","k":"pill","x":70,"y":214,"w":48,"h":4,"fill":"#2EC4CF","r":16,"an":{"k":"wipe"}},{"id":"e088","t":"text","x":70,"y":234,"w":420,"h":120,"html":"La visite 3D et en réalité augmentée de vos projets BIM","st":{"f":"h","fs":30,"fc":"#FFFFFF","ha":"l","va":"t","lh":1.18,"b":1},"an":{"k":"rise"}},{"id":"e089","t":"text","x":70,"y":376,"w":420,"h":250,"html":"<ul><li>Maquettes IFC et GLB ouvertes dans le navigateur</li><li>Orbite, marche à hauteur d'homme, immersion 360°</li><li>Mesure, coupe, rayons X et données de chaque élément</li><li>Réalité augmentée sur Android, de l'échelle 1:200 au 1:1</li></ul>","st":{"f":"b","fs":16,"fc":"#B8C7E0","ha":"l","va":"t","lh":1.45},"an":{"k":"rise"}},{"id":"e090","t":"img","x":520,"y":117,"w":710,"h":445,"src":"m:av_hero_d","fit":"cover","r":12,"shadow":24,"an":{"k":"zoom"}},{"id":"e091","t":"text","x":520,"y":576,"w":710,"h":30,"html":"Une maison d'exemple ouverte dans ArchiVision, avec l'arborescence de la maquette.","st":{"f":"b","fs":13,"fc":"#8EA2C6","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}}],"notes":"ArchiVision, notre application de visite BIM. On ouvre une maquette IFC ou GLB directement dans le navigateur, sans rien installer. On tourne autour, on marche dedans à hauteur d'homme, on passe en immersion 360°. On mesure, on coupe, on voit à travers les murs, et chaque élément affiche ses données IFC. Sur Android, la même maquette passe en réalité augmentée.","tr":"push","nodeco":true,"bg":{"g":["#06123A","#0B1F5C"],"a":160}},{"id":"s07","v":"content","lay":"free","els":[{"id":"e092","t":"text","x":70,"y":50,"w":1140,"h":56,"html":"Inspecter un bâtiment comme sur le chantier","st":{"f":"h","fs":36,"fc":"#0F1B33","ha":"l","va":"t","lh":1.12,"b":1},"an":{"k":"rise"}},{"id":"e093","t":"text","x":70,"y":108,"w":1000,"h":30,"html":"Chaque outil répond à une question concrète de l'équipe projet.","st":{"f":"b","fs":17,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e094","t":"img","x":70,"y":160,"w":360,"h":196,"src":"m:av_xray","fit":"cover","r":12,"stroke":"#DDE5EA","sw":1,"an":{"k":"zoom"}},{"id":"e095","t":"text","x":70,"y":366,"w":360,"h":26,"html":"Rayons X","st":{"f":"h","fs":17,"fc":"#0F1B33","ha":"l","va":"t","lh":1.35,"b":1},"an":{"k":"fade"}},{"id":"e096","t":"text","x":70,"y":392,"w":360,"h":26,"html":"Voir à travers les murs et la toiture","st":{"f":"b","fs":14,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e097","t":"img","x":460,"y":160,"w":360,"h":196,"src":"m:av_mesure","fit":"cover","r":12,"stroke":"#DDE5EA","sw":1,"an":{"k":"zoom"}},{"id":"e098","t":"text","x":460,"y":366,"w":360,"h":26,"html":"Mesure","st":{"f":"h","fs":17,"fc":"#0F1B33","ha":"l","va":"t","lh":1.35,"b":1},"an":{"k":"fade"}},{"id":"e099","t":"text","x":460,"y":392,"w":360,"h":26,"html":"Distances et surfaces relevées en deux clics","st":{"f":"b","fs":14,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e100","t":"img","x":850,"y":160,"w":360,"h":196,"src":"m:av_coupe","fit":"cover","r":12,"stroke":"#DDE5EA","sw":1,"an":{"k":"zoom"}},{"id":"e101","t":"text","x":850,"y":366,"w":360,"h":26,"html":"Coupe","st":{"f":"h","fs":17,"fc":"#0F1B33","ha":"l","va":"t","lh":1.35,"b":1},"an":{"k":"fade"}},{"id":"e102","t":"text","x":850,"y":392,"w":360,"h":26,"html":"Un plan de coupe réglable à la hauteur voulue","st":{"f":"b","fs":14,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e103","t":"img","x":70,"y":432,"w":360,"h":196,"src":"m:av_marche","fit":"cover","r":12,"stroke":"#DDE5EA","sw":1,"an":{"k":"zoom"}},{"id":"e104","t":"text","x":70,"y":638,"w":360,"h":26,"html":"Marche","st":{"f":"h","fs":17,"fc":"#0F1B33","ha":"l","va":"t","lh":1.35,"b":1},"an":{"k":"fade"}},{"id":"e105","t":"text","x":70,"y":664,"w":360,"h":26,"html":"Parcourir le projet à hauteur d'homme","st":{"f":"b","fs":14,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e106","t":"img","x":460,"y":432,"w":360,"h":196,"src":"m:av_ifc","fit":"cover","r":12,"stroke":"#DDE5EA","sw":1,"an":{"k":"zoom"}},{"id":"e107","t":"text","x":460,"y":638,"w":360,"h":26,"html":"Données IFC","st":{"f":"h","fs":17,"fc":"#0F1B33","ha":"l","va":"t","lh":1.35,"b":1},"an":{"k":"fade"}},{"id":"e108","t":"text","x":460,"y":664,"w":360,"h":26,"html":"Arborescence et propriétés de chaque élément","st":{"f":"b","fs":14,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e109","t":"img","x":850,"y":432,"w":360,"h":196,"src":"m:av_sombre","fit":"cover","r":12,"stroke":"#DDE5EA","sw":1,"an":{"k":"zoom"}},{"id":"e110","t":"text","x":850,"y":638,"w":360,"h":26,"html":"Interface sombre","st":{"f":"h","fs":17,"fc":"#0F1B33","ha":"l","va":"t","lh":1.35,"b":1},"an":{"k":"fade"}},{"id":"e111","t":"text","x":850,"y":664,"w":360,"h":26,"html":"Thème clair ou sombre, au choix","st":{"f":"b","fs":14,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}}],"notes":"Six outils, six questions du quotidien. Les rayons X montrent la structure, la mesure relève une distance en deux clics, la coupe ouvre le bâtiment à la hauteur voulue, la marche permet de vérifier les volumes à hauteur d'homme, et les données IFC donnent la composition de chaque élément.","tr":"slide","nodeco":true,"bg":{"c":"#FFFFFF"}},{"id":"s08","v":"content","lay":"free","els":[{"id":"e112","t":"text","x":70,"y":120,"w":420,"h":30,"html":"ArchiVision","st":{"f":"b","fs":16,"fc":"#2EC4CF","ha":"l","va":"t","lh":1.35,"b":1},"an":{"k":"fade"}},{"id":"e113","t":"text","x":70,"y":150,"w":470,"h":130,"html":"Sur le chantier, dans la main","st":{"f":"h","fs":40,"fc":"#FFFFFF","ha":"l","va":"t","lh":1.12,"b":1},"an":{"k":"rise"}},{"id":"e114","t":"text","x":70,"y":290,"w":450,"h":170,"html":"ArchiVision s'utilise aussi sur téléphone. Avec l'application Android (Unity et ARCore), la maquette se pose sur une table, puis passe à l'échelle réelle sur le terrain.","st":{"f":"b","fs":17,"fc":"#B8C7E0","ha":"l","va":"t","lh":1.55},"an":{"k":"rise"}},{"id":"e115","t":"shape","k":"round","x":70,"y":480,"w":420,"h":118,"fill":"#0E2560","r":16,"an":{"k":"rise"}},{"id":"e116","t":"text","x":96,"y":496,"w":380,"h":54,"html":"1:200 → 1:1","st":{"f":"h","fs":40,"fc":"#FFFFFF","ha":"l","va":"t","lh":1.35,"b":1},"an":{"k":"rise"}},{"id":"e117","t":"text","x":96,"y":556,"w":380,"h":30,"html":"de la maquette sur table à l'échelle réelle","st":{"f":"b","fs":14,"fc":"#B8C7E0","ha":"l","va":"t","lh":1.35},"an":{"k":"rise"}},{"id":"e118","t":"shape","k":"round","x":600,"y":110,"w":190,"h":420,"fill":"#0A0F22","r":34,"stroke":"#2A3A6E","sw":2,"shadow":26,"an":{"k":"rise"}},{"id":"e119","t":"img","x":609,"y":120,"w":172,"h":400,"src":"m:av_m_visite","fit":"cover","r":26,"an":{"k":"rise"}},{"id":"e120","t":"text","x":600,"y":544,"w":190,"h":26,"html":"Visite","st":{"f":"b","fs":14,"fc":"#B8C7E0","ha":"c","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e121","t":"shape","k":"round","x":810,"y":70,"w":190,"h":420,"fill":"#0A0F22","r":34,"stroke":"#2A3A6E","sw":2,"shadow":26,"an":{"k":"rise"}},{"id":"e122","t":"img","x":819,"y":80,"w":172,"h":400,"src":"m:av_m_panneau","fit":"cover","r":26,"an":{"k":"rise"}},{"id":"e123","t":"text","x":810,"y":504,"w":190,"h":26,"html":"Données","st":{"f":"b","fs":14,"fc":"#B8C7E0","ha":"c","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e124","t":"shape","k":"round","x":1020,"y":110,"w":190,"h":420,"fill":"#0A0F22","r":34,"stroke":"#2A3A6E","sw":2,"shadow":26,"an":{"k":"rise"}},{"id":"e125","t":"img","x":1029,"y":120,"w":172,"h":400,"src":"m:av_m_ar","fit":"cover","r":26,"an":{"k":"rise"}},{"id":"e126","t":"text","x":1020,"y":544,"w":190,"h":26,"html":"Réalité augmentée","st":{"f":"b","fs":14,"fc":"#B8C7E0","ha":"c","va":"t","lh":1.35},"an":{"k":"fade"}}],"notes":"Sur mobile, l'interface s'adapte : visite, données, et le mode réalité augmentée. L'application Android, développée avec Unity et ARCore, pose la maquette sur une table au 1:200, puis à l'échelle 1:1 directement sur le terrain : le client voit son projet en vrai, à sa place.","tr":"push","nodeco":true,"bg":{"g":["#06123A","#0B1F5C"],"a":160}},{"id":"s09","v":"content","lay":"free","els":[{"id":"e127","t":"shape","k":"round","x":800,"y":70,"w":340,"h":124,"fill":"#FFFFFF","r":14,"an":{"k":"fade"}},{"id":"e128","t":"img","x":820,"y":90,"w":300,"h":84,"src":"m:architrafic","fit":"contain","an":{"k":"fade"}},{"id":"e129","t":"shape","k":"pill","x":800,"y":214,"w":48,"h":4,"fill":"#F28C1E","r":16,"an":{"k":"wipe"}},{"id":"e130","t":"text","x":800,"y":234,"w":420,"h":80,"html":"Concevoir et gérer le trafic autour d'un chantier","st":{"f":"h","fs":30,"fc":"#FFFFFF","ha":"l","va":"t","lh":1.18,"b":1},"an":{"k":"rise"}},{"id":"e131","t":"text","x":800,"y":340,"w":420,"h":250,"html":"<ul><li>Données réelles du site : OpenStreetMap, IGN BD TOPO et RGE ALTI</li><li>Fermetures de voies et déviations calculées automatiquement</li><li>Bibliothèque de signalisation et phasage du chantier</li><li>Simulation du trafic en 3D</li></ul>","st":{"f":"b","fs":16,"fc":"#B8C7E0","ha":"l","va":"t","lh":1.45},"an":{"k":"rise"}},{"id":"e132","t":"img","x":50,"y":117,"w":710,"h":445,"src":"m:at_hero_d","fit":"cover","r":12,"shadow":24,"an":{"k":"zoom"}},{"id":"e133","t":"text","x":50,"y":576,"w":710,"h":30,"html":"Projet d'exemple : fermeture de voie, déviations et panneaux posés en 3D.","st":{"f":"b","fs":13,"fc":"#8EA2C6","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}}],"notes":"ArchiTrafic : les outils de conception et de gestion du trafic. On part des données réelles du site, OpenStreetMap et IGN, relief compris. On ferme une voie : les déviations sont calculées automatiquement, on pose la signalisation depuis une bibliothèque, on organise le chantier en phases, et on simule le trafic en 3D. (Pour ces captures, le quartier est un quartier de démonstration.)","tr":"push","nodeco":true,"bg":{"g":["#06123A","#0B1F5C"],"a":160}},{"id":"s10","v":"content","lay":"free","els":[{"id":"e134","t":"text","x":70,"y":50,"w":1140,"h":56,"html":"Du plan de signalisation au dossier administratif","st":{"f":"h","fs":34,"fc":"#0F1B33","ha":"l","va":"t","lh":1.12,"b":1},"an":{"k":"rise"}},{"id":"e135","t":"text","x":70,"y":106,"w":1000,"h":30,"html":"Tout ce que demandent la mairie, les riverains et les équipes de pose sort du même projet.","st":{"f":"b","fs":17,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e136","t":"img","x":70,"y":160,"w":640,"h":479,"src":"m:at_plan_l","fit":"cover","r":12,"shadow":24,"an":{"k":"zoom"}},{"id":"e137","t":"text","x":70,"y":651,"w":640,"h":26,"html":"Le plan de signalisation en 2D","st":{"f":"b","fs":13,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e138","t":"img","x":740,"y":160,"w":198,"h":470,"src":"m:at_export","fit":"contain","r":10,"shadow":18,"stroke":"#DDE5EA","sw":1,"an":{"k":"rise"}},{"id":"e139","t":"text","x":740,"y":642,"w":238,"h":26,"html":"Le menu Exporter","st":{"f":"b","fs":13,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e140","t":"text","x":978,"y":150,"w":232,"h":90,"html":"13","st":{"f":"h","fs":84,"fc":"#F28C1E","ha":"l","va":"t","lh":1.35,"b":1},"an":{"k":"pop"}},{"id":"e141","t":"text","x":978,"y":250,"w":232,"h":50,"html":"exports prêts à envoyer","st":{"f":"b","fs":17,"fc":"#0F1B33","ha":"l","va":"t","lh":1.3,"b":1},"an":{"k":"fade"}},{"id":"e142","t":"text","x":978,"y":310,"w":232,"h":330,"html":"<ul><li>Projet d'arrêté</li><li>Avis aux riverains</li><li>Devis estimatif</li><li>Fiche de pose terrain</li><li>Plan A3 en PDF</li><li>Fermetures GPS (Waze)</li><li>DXF, GLB, GeoJSON, CSV</li></ul>","st":{"f":"b","fs":15,"fc":"#4A5570","ha":"l","va":"t","lh":1.3},"an":{"k":"rise"}}],"notes":"Le plan 2D est généré à partir de la même scène. Et surtout, le dossier complet sort en un clic : projet d'arrêté, avis aux riverains, devis estimatif, fiche de pose pour les équipes, plan A3, fermetures transmises aux GPS, et les formats techniques DXF, GLB, GeoJSON et CSV. Treize exports au total.","tr":"slide","nodeco":true,"bg":{"c":"#FFFFFF"}},{"id":"s11","v":"content","lay":"free","els":[{"id":"e143","t":"img","x":0,"y":0,"w":1280,"h":720,"src":"m:at_sim","fit":"cover"},{"id":"e144","t":"shape","k":"rect","x":0,"y":0,"w":1280,"h":720,"fill":"#040B26F2","r":0,"g2":"#040B2600","ga":90},{"id":"e145","t":"text","x":70,"y":330,"w":520,"h":30,"html":"ArchiTrafic","st":{"f":"b","fs":16,"fc":"#F28C1E","ha":"l","va":"t","lh":1.35,"b":1},"an":{"k":"fade"}},{"id":"e146","t":"text","x":70,"y":360,"w":560,"h":120,"html":"Simuler le trafic avant de fermer une rue","st":{"f":"h","fs":40,"fc":"#FFFFFF","ha":"l","va":"t","lh":1.12,"b":1},"an":{"k":"rise"}},{"id":"e147","t":"text","x":70,"y":490,"w":500,"h":120,"html":"Véhicules, feux et piétons circulent sur le réseau du projet. On observe les déviations en vue piéton, en 3D ou en plan, avant le premier coup de pelle.","st":{"f":"b","fs":17,"fc":"#D2DCEE","ha":"l","va":"t","lh":1.55},"an":{"k":"rise"}}],"notes":"La simulation : véhicules, feux tricolores et piétons. Ici en vue piéton, au niveau de la rue. On voit tout de suite si une déviation tient la route, avant même d'ouvrir le chantier.","tr":"fade","nodeco":true},{"id":"s14","v":"content","lay":"free","els":[{"id":"e171","t":"shape","k":"round","x":70,"y":80,"w":380,"h":102,"fill":"#FFFFFF","r":14,"an":{"k":"fade"}},{"id":"e172","t":"img","x":70,"y":80,"w":380,"h":102,"src":"m:archiplan","fit":"contain","an":{"k":"fade"}},{"id":"e173","t":"shape","k":"pill","x":70,"y":214,"w":48,"h":4,"fill":"#3D7BE0","r":16,"an":{"k":"wipe"}},{"id":"e174","t":"text","x":70,"y":234,"w":420,"h":110,"html":"Le modeleur 3D de la gamme","st":{"f":"h","fs":32,"fc":"#0F1B33","ha":"l","va":"t","lh":1.12,"b":1},"an":{"k":"rise"}},{"id":"e175","t":"text","x":70,"y":330,"w":420,"h":200,"html":"Plan, 3D et rendu dans la même fenêtre, avec une ligne de commande inspirée d'AutoCAD. Les maquettes s'exportent en GLB et en IFC, et s'ouvrent directement dans ArchiVision.","st":{"f":"b","fs":17,"fc":"#4A5570","ha":"l","va":"t","lh":1.55},"an":{"k":"rise"}},{"id":"e176","t":"img","x":540,"y":60,"w":670,"h":420,"src":"m:ap_render_l","fit":"cover","r":12,"shadow":24,"an":{"k":"zoom"}},{"id":"e177","t":"img","x":540,"y":504,"w":323,"h":148,"src":"m:ap_3d","fit":"cover","r":10,"stroke":"#DDE5EA","sw":1,"an":{"k":"zoom"}},{"id":"e178","t":"img","x":887,"y":504,"w":323,"h":148,"src":"m:av_glb","fit":"cover","r":10,"stroke":"#DDE5EA","sw":1,"an":{"k":"zoom"}},{"id":"e179","t":"text","x":540,"y":658,"w":323,"h":24,"html":"Modélisé dans ArchiPlan…","st":{"f":"b","fs":13,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}},{"id":"e180","t":"text","x":887,"y":658,"w":323,"h":24,"html":"…et ouvert tel quel dans ArchiVision","st":{"f":"b","fs":13,"fc":"#4A5570","ha":"l","va":"t","lh":1.35},"an":{"k":"fade"}}],"notes":"ArchiPlan complète la gamme : c'est le modeleur. Plan, 3D et rendu dans la même fenêtre, avec une ligne de commande pour ceux qui viennent d'AutoCAD. Une maquette créée ici s'ouvre directement dans ArchiVision, comme on le voit en bas.","tr":"push","nodeco